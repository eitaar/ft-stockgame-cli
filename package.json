{
  "name": "ft-stockgame-cli",
  "version": "2.0.0",
  "description": "CLI + Hono HTTP/MCP server for the FT Stock Picking Game (unofficial, reverse-engineered).",
  "type": "module",
  "bin": {
    "stockgame": "./dist/node/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/node/index.js",
    "./worker": "./dist/worker.js"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.1",
    "deno": ">=2"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "tsx src/node/cli.ts",
    "serve": "tsx src/node/serve.ts",
    "start": "node dist/node/serve.js",
    "dev:worker": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "dry-run": "npx wrangler deploy --dry-run --outdir .wrangler-dry",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
